# Runner bindings for the model-heavy Inkling lanes (@d2 greedy, @d2 KLD, @d3) — a BOOKED
# nvidia window (resident model servers quieted, MemAvailable >= 160 GiB; see
# tools/run-d2-parity.ben.sh precond()). Source it via tests/bdd/run-local.sh <this file>.
# Every path resolves fail-closed: unset/missing -> the scenario skips before any launch.
#
# NEVER point {base} at the oracle directory: in this fork llama-perplexity's
# --kl-divergence-base SAVES (overwrites) when --kl-divergence is absent. The commands
# below read a sha-guarded working copy; make it first:
#   cp -p "$INKLING_ORACLE_DIR/kld-base-4x2048.bin" /fast/build/agents/ben/d2-inkling/kld-base-banded.bin
#   sha256sum /fast/build/agents/ben/d2-inkling/kld-base-banded.bin   # aeab1142...
BIN=/fast/build/agents/ben/d2-inkling/build-cuda/bin          # CUDA-built, run CPU-only (like the oracle)
export INKLING_MODEL_PATH=/fast/models/unsloth/Inkling-Small-GGUF/UD-Q4_K_M/Inkling-Small-UD-Q4_K_M-00001-of-00005.gguf
export INKLING_ORACLE_DIR=/fast/build/agents/noah/p1/d0-oracle-20260915T2024
export INKLING_ENVELOPE_JSON=tests/bdd/fixtures/inkling-envelope.json
export INKLING_PPL_TEXT=/fast/build/llama.cpp-inkling/eval-q4km/wikitext-2-raw/wiki.test.raw
KLD_BASE_COPY=/fast/build/agents/ben/d2-inkling/kld-base-banded.bin

# @d2 greedy: llama-server driven with the D0 request body over the D0 prompt set (masked path).
export INKLING_GREEDY_CMD="python3 tools/inkling-greedy-dump.py --server $BIN/llama-server --model {model} --prompts {oracle_dir}/greedy-64x8.json --n-predict 64 --n-probs 10 --server-args \"-ngl 0 -t 20 -c 4096 -np 1 --jinja -fa off\""
# @d2 KLD: masked path (-fa off) vs the banded base. {base} is substituted but MUST stay a copy.
export INKLING_PPL_CMD="$BIN/llama-perplexity -m {model} -ngl 0 -t 20 -f {text} -c 2048 -b 2048 --chunks 4 -fa off --kl-divergence --kl-divergence-base $KLD_BASE_COPY"
# @d3 cache lane: the banded cache path (-fa on: one cache + GGML_OP_FLASH_ATTN_EXT_BANDED).
export INKLING_D3_PPL_CMD="$BIN/llama-perplexity -m {model} -ngl 0 -t 20 -f {text} -c 2048 -b 2048 --chunks 4 -fa on --kl-divergence --kl-divergence-base $KLD_BASE_COPY"
# Feature parity (token-for-token gate only when equal): the oracle build ran AVX2/FMA/LLAMAFILE/REPACK.
export INKLING_ORACLE_FEATURES="AVX2,FMA,LLAMAFILE,REPACK"
# export INKLING_BUILD_FEATURES="AVX2,FMA,LLAMAFILE,REPACK"   # declare ONLY after reading the build's system_info line

# Fixture lanes on the same host (no window needed): binaries + threads.
export LLAMA_SERVER_BIN=$BIN/llama-server
export LLAMA_STAGE_RUNNER_BIN=$BIN/llama-stage-runner
export LLAMA_EXPERT_CHECK_BIN=$BIN/llama-expert-check
export LLAMA_PERPLEXITY_BIN=$BIN/llama-perplexity
export LLAMA_CLI_BIN=$BIN/llama-cli
# export LLAMA_EXPERT_SERVER_BIN=...   # @d4c needs an expert-server built from a D4c-capable tree
export INKLING_BDD_THREADS=20
export CUDA_VISIBLE_DEVICES=""
export BDD_TEST_TARGET=tests/bdd/test_inkling.py
